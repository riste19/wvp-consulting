# Cloudflare Pages headers. Copied into out/_headers by `next build`.
#
# These apply to static assets only. The contact Function sets its own headers
# in functions/api/contact.ts.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  X-XSS-Protection: 0
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; frame-ancestors 'self'; form-action 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests

# A note on script-src 'unsafe-inline': it is unavoidable here and is a
# considered trade-off, not an oversight. A static export has no per-request
# nonce, and every page carries an inline RSC flight payload plus JSON-LD.
# Hashes would change on each build. The policy still blocks every external
# script origin except Turnstile, and locks down object-src, form-action and
# base-uri. To tighten it later, ship Content-Security-Policy-Report-Only
# alongside for a week and read the reports first.

# Filenames under here are content-hashed, so they can never go stale.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/icon.svg
  Cache-Control: public, max-age=604800

# Deliberately no rule for *.html or *.txt — those change on every deploy and
# must keep revalidating.
